     <script type="text/javascript">
         
    google.charts.load('current', {'packages':['corechart']});
    google.charts.setOnLoadCallback(drawChart1);
    var chartEditor = null;

    function loadEditor() {

      var data = new google.visualization.DataTable();
        data.addColumn('string', 'Topping');
        data.addColumn('number', '{{id1}}');
        data.addColumn('number', '{{id2}}');
        data.addRows([
        
         {% for nomTable1 in nomTable1 %}
          [ '{{ attribute(nomTable1, id3) }}' ,{{ attribute(nomTable1, id1) }},{{ attribute(nomTable1, id2) }}],{% endfor %}

        ]);

        var option = {  
            title: 'Nb de {{ id1 }} en fonction de {{ id2}} ',
            hAxis: {title: '{{id1}}'},
            vAxis: {title: '{{id2}}'},
            legend: 'none',
            trendlines: { 0: {} }
        };
      // Create the chart to edit.
           var wrapper = new google.visualization.ChartWrapper({
    chartType: 'ColumnChart',
    dataTable: data,
    options: option,
    containerId: 'visualization'
  });



      chartEditor = new google.visualization.ChartEditor();
      google.visualization.events.addListener(chartEditor, 'ok', redrawChart);
      chartEditor.openDialog(wrapper, {});
    }

    function drawChart1(){

       var data = google.visualization.arrayToDataTable
          ([
            ['{{id1}}', '{{id2}}'],
            {% for nomTable1 in nomTable1 %}
            [{{ attribute(nomTable1, id1) }}, {{ attribute(nomTable1, id2) }}],{% endfor %}
            ]);
        var option = {  
            title: 'Nb de {{ id1 }} en fonction de {{ id2}}',
            width: '550',
            height: '300',
            hAxis: {title: '{{id1}}'},
            vAxis: {title: '{{id2}}'},
            legend: 'none',
            trendlines: { 0: {} }
            };

      var chart = new google.visualization.ScatterChart(document.getElementById('vis_div'));
      chart.draw(data, option);
    }
    // On "OK" save the chart to a <div> on the page.
    function redrawChart(){
      chartEditor.getChartWrapper().draw(document.getElementById('vis_div')); 
       

    }
    </script>

    <script > 

    google.charts.load('current', {'packages':['corechart']});

      // Set a callback to run when the Google Visualization API is loaded.
      google.charts.setOnLoadCallback(drawChart);

      // Callback that creates and populates a data table,
      // instantiates the pie chart, passes in the data and
      // draws it.
      function drawChart() {

        // Create the data table.
        var data = new google.visualization.DataTable();
        data.addColumn('string', 'Topping');
        data.addColumn('number', 'Slices');
        data.addRows([
         {% for nomTable1 in nomTable1 %}
          [ '{{ attribute(nomTable1, id3) }}' , {{ attribute(nomTable1, id1) }}],{% endfor %} 
        ]);

        // Set chart options
        var options = {'title':'Nb de {{ id1 }} par {{ id3}}',
                       'width':400,
                       'height':300};
 
        // Instantiate and draw our chart, passing in some options.
        var chart = new google.visualization.PieChart(document.getElementById('chart_div3'));

        function selectHandler() {
          var selectedItem = chart.getSelection()[0];
          if (selectedItem) {
            var number = data.getValue(selectedItem.row, 0);
            var msg = 'Vous avez cliquée sur: ' + number;
            //alert(msg);
            //window.location.replace("/a");
            if (window.confirm('Vous avez cliquée sur: ' + number + '\nVoir plus?'))
            {
             window.location.replace('/info3/'+number);
            }
          }
        }

        google.visualization.events.addListener(chart, 'select', selectHandler);    
        chart.draw(data, options);
      }

      </script>

