{% extends "/base.html.twig" %}


    {% block title %} SalleTpBundle {% endblock %}
    {% block stylesheets %}
        <meta content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0' name='viewport' />
    <meta name="viewport" content="width=device-width" />


    <!-- Modification de la page avec css     -->
    <link href="{{ asset('bundles/salletp/assets/css/bootstrap.min.css') }}" rel="stylesheet" />

    <!--  Fichier css pour les pages   -->
    <link href="{{ asset('bundles/salletp/assets/css/light-bootstrap-dashboard.css?v=1.4.0') }}" rel="stylesheet"/>

    <!--     Import des Icones      -->
    <link href="http://maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" rel="stylesheet">
    <link href='http://fonts.googleapis.com/css?family=Roboto:400,700,300' rel='stylesheet' type='text/css'>
    <link href="{{ asset('bundles/salletp/assets/css/pe-icon-7-stroke.css') }}" rel="stylesheet" />
    <style type="text/css">
        #form_Nom_de_la_table_des_donnees {

    width: 150px;
    border-radius: 9px;
    height: 40px;
    color: white;
    background-color: #444;
    font-weight: bold;
    text-align: center;
    margin-left: 14px;

}
    </style>
    {% endblock %}

        {% block javascripts %}
<script src="https://code.highcharts.com/stock/highstock.js"></script>
    <script src="{{ asset('bundles/salletp/js/highcharts.js') }}"></script>
    <script src="https://code.jquery.com/jquery-3.1.1.min.js"></script>
<script>
$.getJSON('https://www.highcharts.com/samples/data/aapl-c.json', function (data) {
    // Create the chart
    Highcharts.stockChart('container', {


        rangeSelector: {
            selected: 1
        },

        title: {
            text: 'AAPL Stock Price'
        },

        series: [{
            name: 'AAPL',
            data: [{% for nomTable1 in nomTable1 %}
        [  Date.UTC({{ attribute(nomTable1, id3)|date('Y,m,d') }}) ,{{ attribute(nomTable1, id1) }} ],

    {% endfor %}],
            tooltip: {
                valueDecimals: 2
            }
        }]
    });
});
</script>
        {% endblock %}

        {% block titre %} Dashboard {% endblock %}

        {% block menuGauche %}
        <ul class="nav"> 
                <li >
                    <a href="/a">
                        <i class="pe-7s-home"></i> <!-- Icone du menu-->
                        <p>Dashboard</p>
                    </a>
                </li>
                <li class="active"> <!--Menu active a gauche en fonction de la page-->
                    <a href="">
                        <i class="pe-7s-graph"></i>
                        <p>Dashboard</p>
                    </a>
                </li>
                <li>
                    <a href="">
                        <i class="pe-7s-note2"></i>
                        <p>Table List</p>
                    </a>
                </li>
                </ul>{% endblock %}

