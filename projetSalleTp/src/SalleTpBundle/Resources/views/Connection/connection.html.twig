<!DOCTYPE html>

<html lang="fr">

  <style>

  body{
  margin: 0px;
  }

  .conteneur-connection{
    font-family: 'Open Sans', sans-serif;
    background-color: #FFFFFF;
    color: #666666;
    width: 600px;
    border-radius: 5px;
    margin: 0 auto;
    margin-top: 50px;
    position: relative;
    box-shadow: 0px 0px 50px rgba(0, 0, 0, 0.26);
    animation: show 1.5s;
  }
  .contenu{
    padding: 20px 50px;
    text-align: center;
    margin-bottom: 0px;
  }
  h1{
    font-weight: 400;
    text-align: center;
    color: #23408e;
  }
  .valeurs{
    width: 100%;
    margin-bottom: 60px;
    margin-top: 0px;
  }
  input{
    font-family: 'Open Sans', sans-serif;
    clear: both;
    display: block;
    width: 100%;
    margin: 00px 0px; 
    padding: 10px;
    outline: none;
    border: none;
    border-bottom: 1px solid #E8E9EC;
    color: #666666;
  }
  a{
    text-decoration: none;
    color: #666666;
  }
  
   
  .seConnecter{
    border: none;
    background-color: #23408e;
    font-family: 'Open Sans', sans-serif;
    color: white;
    text-align: center;
    width: 50%;
    padding: 20px;
    float: right;
    border-radius: 0px 0px 5px 5px;
  } 




</style>

<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">

  <title>Connection</title>

</head>

<body>



  <div class="conteneur-connection">

    <form action="#">
      <div class="contenu">
        <h1>Connection</h1>
        <div class="valeurs">
          <input type="identifiant" placeholder="Identifiant" />
          <input type="motDePasse" placeholder="Mot de Passe" />
        </div>
      </div>
      <div>
        <input type="submit" value="Connection" class="seConnecter" />
      </div>
    </form>
  </div>

</body>

</html>
