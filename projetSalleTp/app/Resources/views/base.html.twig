<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <title>{% block title %}{% endblock %}</title>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        {% block javascripts %}{% endblock %}
<div class="div-principal">
    <div class="Barre-gauche" couleur-barreDeGauche="blue" imageArrierePlan-barreDeGauche="">

