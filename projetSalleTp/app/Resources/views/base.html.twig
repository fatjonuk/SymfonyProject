        Possibilité d'ajouter image en arrier plan de la barre de gauche en ajoutant l'url de l'image dans imageArrierePlan-barreDeGauche=""

    -->

      <div class="Barre-gauche-div-principal">
            <div class="logo">
                <a href="" class="simple-text">
                    <!-- titre a gauche en haut -->
                    {% block titre %}{% endblock %}
                </a>
            </div>
            <!-- Menu de gauche -->
            {% block menuGauche %}{% endblock %}
